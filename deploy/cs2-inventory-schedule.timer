[Unit]
Description=CS2 inventory snapshots at 07:00, 14:00 and 21:00 Asia/Shanghai

[Timer]
OnCalendar=*-*-* 07:00:00 Asia/Shanghai
OnCalendar=*-*-* 14:00:00 Asia/Shanghai
OnCalendar=*-*-* 21:00:00 Asia/Shanghai
Persistent=true
AccuracySec=1s
Unit=cs2-inventory-schedule.service

[Install]
WantedBy=timers.target
