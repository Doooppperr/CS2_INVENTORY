[Unit]
Description=Six-times-daily CS2 inventory snapshots at 00/04/08/12/16/20 Asia/Shanghai

[Timer]
OnCalendar=*-*-* 00:00:00 Asia/Shanghai
OnCalendar=*-*-* 04:00:00 Asia/Shanghai
OnCalendar=*-*-* 08:00:00 Asia/Shanghai
OnCalendar=*-*-* 12:00:00 Asia/Shanghai
OnCalendar=*-*-* 16:00:00 Asia/Shanghai
OnCalendar=*-*-* 20:00:00 Asia/Shanghai
Persistent=true
AccuracySec=1min
Unit=cs2-inventory-schedule.service

[Install]
WantedBy=timers.target
