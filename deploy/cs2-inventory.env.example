STEAMWEBAPI_KEY=replace-me
CS2_ITEM_LANGUAGE=schinese
CS2_SECRET_KEY=replace-with-at-least-32-random-bytes
CS2_PASSWORD_VAULT_KEY=replace-with-a-separate-stable-random-secret
CS2_COOKIE_SECURE=0
CS2_COOKIE_PATH=/cs2_inventory/
# Console reference value only; target insertion can exceed it.
CS2_MAX_TARGETS=80
# Provider limits and alert-only reserves; scans are never stopped by these values.
CS2_MONTHLY_BUDGET=150000
CS2_DAILY_BUDGET=5000
CS2_INVENTORY_RESERVE=30000
CS2_INVENTORY_CRITICAL_RESERVE=15000
CS2_INVENTORY_CREDITS_PER_REQUEST=3
